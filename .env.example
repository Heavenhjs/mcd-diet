# 麦当劳 MCP Token
# 申请地址：https://open.mcd.cn/mcp （登录 → 控制台 → 激活 → 复制 Token）
# 不要把真实 Token 写进任何会提交到 Git 的文件里（参赛声明的信息安全要求）
MCD_MCP_TOKEN=your_mcd_mcp_token_here

# MCP Server 地址，一般不需要改
MCD_MCP_URL=https://mcp.mcd.cn

# 可选：默认门店。不填时会尝试从历史订单自动识别门店编码
# MCD_STORE_CODE=1410005

# 可选：外送/团餐场景（orderType=2）的 beCode。
# 注意：到店场景（orderType=1）**不能**传 beCode，传了 MCP 会直接报错。
# MCD_BE_CODE=
